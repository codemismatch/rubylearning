require "./theme_converter"

module Typophic
  module Commands
    class Theme < Base
      def self.run(args : Array(String))
        new.run(args)
      end

      def run(args : Array(String)) : Nil
        if args.empty?
          puts help_text
          return
        end

        subcommand = args.shift
        case subcommand
        when "new"
          New.new(args).run
        when "use", "switch"
          Use.new(args).run
        when "install"
          Install.new(args).run
        when "list"
          List.run(args)
        when "remove", "rm"
          Remove.new(args).run
        when "convert"
          Convert.new(args).run
        when "help", "--help", "-h"
          puts help_text
        else
          puts "Unknown theme subcommand: #{subcommand}"
          puts help_text
          exit 1
        end
      end

      def help_text
        <<-HELP
        Usage: typophic theme <command> [options]

        Commands:
          new NAME              Scaffold a new theme under themes/NAME
          use NAME [options]    Set default or section theme in config.yml
          install URL|OWNER/REPO[#ref] [--name NAME]
                                Install a theme from GitHub into themes/NAME
          list                  List installed themes
          remove NAME           Remove an installed theme directory
          convert PATH [NAME]   Convert a Hugo theme at PATH to a Typophic theme

        Options for `use`:
          --default           Make NAME the default site theme
          --section SECTION   Apply NAME to a section (e.g., posts)

        Run `typophic theme new --help` for command-specific options.
        HELP
      end

      class New
        @options : Hash(Symbol, String)
        @theme_name : String

        def initialize(args)
          @options = {
            :path => Dir.current,
            :site_name => "Typophic Site",
            :description => "A Typophic theme",
            :author => "Typophic User"
          }
          @theme_name = ""

          parser = OptionParser.new do |opts|
            opts.banner = "Usage: typophic theme new NAME [options]"
            opts.on("--path DIR", "Root directory (default: current working directory)") { |dir| @options[:path] = File.expand_path(dir) }
            opts.on("--site-name NAME", "Default site title used in the layout") { |name| @options[:site_name] = name }
            opts.on("--description TEXT", "Default meta description") { |text| @options[:description] = text }
            opts.on("--author NAME", "Footer attribution") { |author| @options[:author] = author }
            opts.on("-h", "--help", "Show this help message") { puts opts; exit }
          end
          parser.parse(args)
          
          @theme_name = args.shift? || ""
          if @theme_name.strip.empty?
            puts "Theme name is required."
            puts parser
            exit 1
          end
        end

        def run
          target = target_path
          puts "Creating theme '#{@theme_name}' in #{target}"
          
          # Basic scaffolding since ThemeScaffolder might not be ported yet
          # Or we can implement a simple one here
          full_path = File.join(target, @theme_name)
          if Dir.exists?(full_path)
            puts "Theme directory already exists: #{full_path}"
            exit 1
          end
          
          FileUtils.mkdir_p(File.join(full_path, "layouts"))
          FileUtils.mkdir_p(File.join(full_path, "includes"))
          FileUtils.mkdir_p(File.join(full_path, "css"))
          FileUtils.mkdir_p(File.join(full_path, "js"))
          FileUtils.mkdir_p(File.join(full_path, "images"))
          
          # Create default layout
          File.write(File.join(full_path, "layouts", "default.html.erb"), default_layout_content)
          File.write(File.join(full_path, "css", "style.css"), "/* Theme: #{@theme_name} */\n")
          
          puts "Theme ready at #{full_path}"
        end

        private def target_path
          File.join(@options[:path], "themes")
        end
        
        private def default_layout_content
          <<-HTML
          <!DOCTYPE html>
          <html>
          <head>
            <title><%= page["title"] %></title>
            <link rel="stylesheet" href="/themes/#{@theme_name}/css/style.css">
          </head>
          <body>
            <%= content %>
          </body>
          </html>
          HTML
        end
      end

      class Use
        @default : Bool
        @section : String?
        @theme : String

        def initialize(args)
          @default = false
          @section = nil
          @theme = ""
          
          parser = OptionParser.new do |opts|
            opts.banner = "Usage: typophic theme use NAME [--default] [--section SECTION]"
            opts.on("--default", "Set as default theme") { @default = true }
            opts.on("--section SECTION", "Section to target (e.g., posts)") { |s| @section = s }
            opts.on("-h", "--help", "Show help") { puts opts; exit }
          end
          parser.parse(args)
          
          @theme = args.shift? || ""
          if @theme.strip.empty?
            puts "Theme NAME is required"
            puts parser
            exit 1
          end
        end

        def run
          unless Dir.exists?(File.join("themes", @theme))
            puts "Theme '#{@theme}' does not exist under themes/#{@theme}"
            exit 1
          end

          config_path = "config.yml"
          unless File.exists?(config_path)
            puts "config.yml not found"
            exit 1
          end

          content = File.read(config_path)
          doc = YAML.parse(content)
          
          # We need a mutable hash. YAML::Any is immutable.
          # We'll reconstruct the hash from YAML::Any
          root = ensure_hash(doc)
          
          theme_key = YAML::Any.new("theme")
          current_theme_val = root[theme_key]?
          
          theme_config = normalize_theme_config(current_theme_val)
          
          if section = @section
            sections_key = YAML::Any.new("sections")
            sections = theme_config[sections_key].as_h
            sections[YAML::Any.new(section)] = YAML::Any.new(@theme)
            puts "Applied theme '#{@theme}' to section '#{section}'"
          end

          if @default || !@section
            default_key = YAML::Any.new("default")
            theme_config[default_key] = YAML::Any.new(@theme)
            puts "Set default theme to '#{@theme}'"
          end

          root[theme_key] = YAML::Any.new(theme_config)
          
          File.write(config_path, root.to_yaml)
          puts "Updated config.yml"
        end

        private def ensure_hash(any : YAML::Any) : Hash(YAML::Any, YAML::Any)
          if any.as_h?
            any.as_h.dup
          else
            Hash(YAML::Any, YAML::Any).new
          end
        end

        private def normalize_theme_config(val : YAML::Any?) : Hash(YAML::Any, YAML::Any)
          default_hash = Hash(YAML::Any, YAML::Any).new
          default_hash[YAML::Any.new("default")] = YAML::Any.new("rubylearning")
          default_hash[YAML::Any.new("sections")] = YAML::Any.new(Hash(YAML::Any, YAML::Any).new)

          return default_hash if val.nil?

          if val.as_s?
            h = default_hash.dup
            h[YAML::Any.new("default")] = val
            h
          elsif val.as_h?
            h = val.as_h.dup
            # Ensure sections exists
            sections_key = YAML::Any.new("sections")
            unless h.has_key?(sections_key)
               h[sections_key] = YAML::Any.new(Hash(YAML::Any, YAML::Any).new)
            end
            # Ensure sections is a hash
            unless h[sections_key].as_h?
               h[sections_key] = YAML::Any.new(Hash(YAML::Any, YAML::Any).new)
            end
            h
          else
            default_hash
          end
        end
      end

      class Install
        @name : String?
        @source : String

        def initialize(args)
          @name = nil
          @source = ""
          
          parser = OptionParser.new do |opts|
            opts.banner = "Usage: typophic theme install URL|OWNER/REPO[#ref] [--name NAME]"
            opts.on("--name NAME", "Target theme directory name") { |v| @name = v }
            opts.on("-h", "--help", "Show help") { puts opts; exit }
          end
          parser.parse(args)
          
          @source = args.shift? || ""
          if @source.strip.empty?
            puts "Source required (GitHub URL or OWNER/REPO[#ref])"
            puts parser
            exit 1
          end
        end

        def run
          url, name, ref = resolve_source(@source)
          name = @name || name
          target = File.join("themes", name)
          
          if Dir.exists?(target)
            puts "Theme directory already exists: #{target}"
            exit 1
          end
          
          puts "Installing #{name} from #{url}..."
          unless system("git clone --depth 1 #{url} #{target}")
            abort("git clone failed")
          end
          
          if ref && !ref.strip.empty?
            system("git -C #{target} fetch --all")
            unless system("git -C #{target} checkout #{ref}")
              puts "Failed to checkout ref '#{ref}', staying on default branch"
            end
          end
          puts "Installed theme to #{target}"
          
          # Auto-convert if it looks like a Hugo theme (has config.toml/yaml/json or layouts dir with {{)
          # Since we are installing from Hugo registry or generic git, we assume it might need conversion.
          # We'll run the converter in-place.
          
          puts "Checking for Hugo theme structure..."
          if is_hugo_theme?(target)
            puts "Hugo theme detected. Auto-converting to Typophic format..."
            begin
              # We need to convert in-place. ThemeConverter expects source != target usually,
              # but we can hack it or modify ThemeConverter.
              # Let's move to a temp dir and convert back.
              temp_source = "#{target}_hugo_source"
              FileUtils.mv(target, temp_source)
              
              converter = Typophic::ThemeConverter.new(temp_source, target)
              converter.run
              
              FileUtils.rm_rf(temp_source)
              puts "Auto-conversion complete."
            rescue ex
              puts "Conversion failed: #{ex.message}"
              puts "Restoring original files..."
              FileUtils.rm_rf(target) if Dir.exists?(target)
              FileUtils.mv(temp_source.as(String), target) if Dir.exists?(temp_source.as(String))
            end
          end
        end

        private def is_hugo_theme?(path)
          # Simple heuristic: check for config file or theme.toml
          File.exists?(File.join(path, "theme.toml")) || 
          File.exists?(File.join(path, "hugo.toml")) ||
          File.exists?(File.join(path, "hugo.yaml")) ||
          File.exists?(File.join(path, "config.toml")) ||
          File.exists?(File.join(path, "config.yaml"))
        end

        private def resolve_source(src)
          # 1. Check if it's a direct URL or shorthand
          if src =~ %r{^https?://} || src =~ %r{^git@}
             return {src, infer_name_from_url(src), nil}
          end
          
          if src.includes?("/") && !src.includes?(" ") # Simple heuristic for owner/repo
             return {"https://github.com/#{src}.git", src.split("/")[1].split("#")[0], src.split("#")[1]?}
          end

          # 2. Lookup in data/hugo_themes.yml
          data_file = "data/hugo_themes.yml"
          if File.exists?(data_file)
            begin
              data = YAML.parse(File.read(data_file))
              themes = data["themes"].as_a
              
              # Check if src is an index (1-based)
              if src =~ /^\d+$/
                index = src.to_i
                if index > 0 && index <= themes.size
                  found = themes[index - 1]
                  github_url = found["github_url"].as_s
                  name = found["name"].as_s.downcase.gsub(" ", "-")
                  return {github_url, name, nil}
                else
                  abort("Invalid theme index: #{index}. Available: 1-#{themes.size}")
                end
              end

              # Check by name
              found = themes.find { |t| t["name"].as_s.downcase == src.downcase }
              if found
                github_url = found["github_url"].as_s
                return {github_url, src.downcase.gsub(" ", "-"), nil}
              end
            rescue
              # Ignore parsing errors, fall through
            end
          end

          abort("Could not resolve theme source: '#{src}'. Provide a URL, OWNER/REPO, a valid theme name, or an index from 'typophic theme list --remote'.")
        end

        private def infer_name_from_url(url)
          File.basename(url, ".git")
        end
      end

      class List
        def self.run(args : Array(String) = [] of String)
          remote = false
          parser = OptionParser.new do |opts|
            opts.banner = "Usage: typophic theme list [options]"
            opts.on("--remote", "List available remote themes from Hugo registry") { remote = true }
            opts.on("-h", "--help", "Show help") { puts opts; exit }
          end
          parser.parse(args)

          if remote
            list_remote_themes
          else
            list_installed_themes
          end
        end

        def self.list_installed_themes
          themes_dir = "themes"
          unless Dir.exists?(themes_dir)
            puts "No themes directory found."
            return
          end

          themes = Dir.children(themes_dir).select { |child| File.directory?(File.join(themes_dir, child)) }
          
          if themes.empty?
            puts "No themes installed."
          else
            puts "Installed themes:"
            themes.each do |theme|
              puts "  - #{theme}"
            end
          end
        end

        def self.list_remote_themes
          data_file = "data/hugo_themes.yml"
          unless File.exists?(data_file)
            puts "Error: #{data_file} not found."
            return
          end

          begin
            data = YAML.parse(File.read(data_file))
            themes = data["themes"].as_a
            puts "Available remote themes (from #{data_file}):"
            themes.each_with_index do |theme, i|
              name = theme["name"].as_s
              desc = theme["description"]? ? theme["description"].as_s : "No description"
              puts "  #{i + 1}. #{name}: #{desc}"
            end
          rescue ex
            puts "Error parsing themes data: #{ex.message}"
          end
        end
      end

      class Remove
        def initialize(@args : Array(String))
        end

        def run
          if @args.empty?
            puts "Usage: typophic theme remove NAME"
            exit 1
          end

          name = @args[0]
          target = File.join("themes", name)

          unless Dir.exists?(target)
            puts "Theme '#{name}' not found in themes/"
            exit 1
          end

          FileUtils.rm_rf(target)
          puts "Removed theme '#{name}'"
        end
      end

      class Convert
        @source : String
        @name : String?

        def initialize(args)
          @source = ""
          @name = nil
          
          parser = OptionParser.new do |opts|
            opts.banner = "Usage: typophic theme convert PATH [NAME]"
            opts.on("-h", "--help", "Show help") { puts opts; exit }
          end
          parser.parse(args)
          
          @source = args.shift? || ""
          @name = args.shift?
          
          if @source.strip.empty?
            puts "Source PATH is required"
            puts parser
            exit 1
          end
        end

        def run
          source_path = File.expand_path(@source)
          theme_name = @name || File.basename(source_path)
          target_path = File.join("themes", theme_name)
          
          converter = Typophic::ThemeConverter.new(source_path, target_path)
          converter.run
        rescue ex
          puts "Error: #{ex.message}"
          exit 1
        end
      end
    end
  end
end
